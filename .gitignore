_site/
build/
dist/
public/
out/
.cache/
.next/
.docusaurus/
.vuepress/
.mkdocs/
.sphinx/
site/
docs/.vitepress/cache/

# ------------------------------------------------------
# Node / npm / yarn / pnpm dependencies
# ------------------------------------------------------
node_modules/

# ------------------------------------------------------
# Python virtual envs / Sphinx / MkDocs / Jupyter
# ------------------------------------------------------
venv/
.env/
.env
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# ------------------------------------------------------
# Temporary / local files
# ------------------------------------------------------
.tmp/
temp/
*.log
*.bak
*.swp
*.swo
*.tmp
Thumbs.db

# ------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------
.vscode/
.idea/
*.iml

# ------------------------------------------------------
# OS Files
# ------------------------------------------------------
.DS_Store
ehthumbs.db
Icon?
Desktop.ini

# ------------------------------------------------------
# Miscellaneous
# ------------------------------------------------------
*.local
*.cache
.env.local
.env.development.local
.env.production.local
.env.test.local

# ------------------------------------------------------
# Generated CI fixtures
# ------------------------------------------------------
# ci/rust-examples/src/lib.rs is generated from RUST.md's fenced rust blocks by
# ci/extract_rust_examples.py; the compiled artifacts are never committed either.
ci/rust-examples/target/
ci/rust-examples/src/lib.rs
# ci/plantuml-render/out/ is generated from PlantUML.md's fenced plantuml blocks
# by ci/extract_plantuml.py, plus whatever the renderer writes beside them.
ci/plantuml-render/

# ------------------------------------------------------
# Optional: build artifacts from documentation tools
# ------------------------------------------------------
# If using docs-as-code toolchains like:
# - Docusaurus: /build or /.docusaurus
# - MkDocs: /site
# - VitePress: /docs/.vitepress/dist
# - Hugo: /public
# - Sphinx: /_build
# - Jekyll: /_site
